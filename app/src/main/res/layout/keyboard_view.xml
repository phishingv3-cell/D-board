<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/keyboard_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/keyboard_bg"
    android:paddingStart="4dp"
    android:paddingEnd="4dp"
    android:paddingBottom="6dp">

    <!-- Top Suggestion Strip: Clear icon + 3 word suggestions in green -->
    <LinearLayout
        android:id="@+id/suggestion_strip"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <ImageView
            android:id="@+id/btn_clear_input"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:contentDescription="Clear"
            android:alpha="0.4" />

        <TextView
            android:id="@+id/suggest_1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="I"
            android:textColor="@color/suggestion_green"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/suggest_2"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Let's"
            android:textColor="@color/suggestion_green"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/suggest_3"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="The"
            android:textColor="@color/suggestion_green"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Key Rows Container -->
    <LinearLayout
        android:id="@+id/rows_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

</LinearLayout>
